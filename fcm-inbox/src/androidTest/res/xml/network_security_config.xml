<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow cleartext HTTP to Firebase emulator hosts.
    - localhost: used via `adb reverse tcp:8080 tcp:8080` on physical devices.
    - 10.0.2.2: Android emulator loopback to host localhost (kept for AVD runs).
    This file is only bundled into the androidTest APK; it does NOT ship in production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
